generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum GymRole {
  OWNER
  ADMIN
  RECEPTIONIST
  PROFESSOR
  STUDENT
}

enum ClassGroupLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  MIXED
}

enum ClassGroupProfessorRole {
  PRIMARY
  ASSISTANT
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  name            String     @db.VarChar(150)
  email           String     @unique @db.VarChar(255)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  phone           String?    @db.VarChar(30)
  avatarUrl       String?    @map("avatar_url") @db.Text
  globalRole      GlobalRole @default(USER) @map("global_role")
  active          Boolean    @default(true)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships     GymMembership[]
  sessions        UserSession[]
  passwordResets  PasswordReset[]
  studentProfiles Student[]
  auditLogs       AuditLog[]
  professors      Professor[]

  @@index([active])
  @@index([globalRole])
  @@map("users")
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.Text
  ipAddress  String?   @map("ip_address") @db.VarChar(100)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model PasswordReset {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  codeHash       String    @map("code_hash") @db.VarChar(64)
  resetTokenHash String?   @unique @map("reset_token_hash") @db.VarChar(64)
  attempts       Int       @default(0)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(6)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("password_resets")
}

model Gym {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  phone       String?  @db.VarChar(30)
  email       String?  @db.VarChar(255)
  logoUrl     String?  @map("logo_url") @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships          GymMembership[]
  students             Student[]
  auditLogs            AuditLog[]
  professors           Professor[]
  modalities           Modality[]
  graduations          Graduation[]
  professorModalities  ProfessorModality[]
  classGroups          ClassGroup[]
  classGroupProfessors ClassGroupProfessor[]
  classSchedules       ClassSchedule[]

  @@index([active])
  @@index([createdAt])
  @@map("gyms")
}

model GymMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  gymId     String   @map("gym_id") @db.Uuid
  role      GymRole
  active    Boolean  @default(true)
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Restrict)

  @@unique([userId, gymId], map: "uk_gym_memberships_user_gym")
  @@index([userId])
  @@index([gymId])
  @@index([gymId, role])
  @@index([gymId, active])
  @@map("gym_memberships")
}

model Student {
  id               String    @id @default(uuid()) @db.Uuid
  gymId            String    @map("gym_id") @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  name             String    @db.VarChar(150)
  email            String?   @db.VarChar(255)
  phone            String?   @db.VarChar(30)
  birthDate        DateTime? @map("birth_date") @db.Date
  emergencyContact String?   @map("emergency_contact") @db.VarChar(150)
  emergencyPhone   String?   @map("emergency_phone") @db.VarChar(30)
  notes            String?   @db.Text
  active           Boolean   @default(true)
  joinedAt         DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  gym  Gym   @relation(fields: [gymId], references: [id], onDelete: Restrict)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([gymId, userId], map: "uk_students_gym_user")
  @@index([gymId])
  @@index([gymId, active])
  @@index([gymId, name])
  @@index([userId])
  @@map("students")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  gymId     String?  @map("gym_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  metadata  Json?
  ipAddress String?  @map("ip_address") @db.VarChar(100)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  gym  Gym?  @relation(fields: [gymId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@index([gymId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model SiteSetting {
  id              String   @id @default(uuid()) @db.Uuid
  siteName        String   @default("FightOps") @map("site_name") @db.VarChar(100)
  logoUrl         String?  @map("logo_url") @db.Text
  logoDarkUrl     String?  @map("logo_dark_url") @db.Text
  faviconUrl      String?  @map("favicon_url") @db.Text
  primaryColor    String   @default("#E63737") @map("primary_color") @db.VarChar(20)
  secondaryColor  String   @default("#F04747") @map("secondary_color") @db.VarChar(20)
  backgroundColor String   @default("#080808") @map("background_color") @db.VarChar(20)
  surfaceColor    String   @default("#141414") @map("surface_color") @db.VarChar(20)
  textColor       String   @default("#F6F6F6") @map("text_color") @db.VarChar(20)
  mutedTextColor  String   @default("#9D9D9D") @map("muted_text_color") @db.VarChar(20)
  headingFont     String   @default("Inter") @map("heading_font") @db.VarChar(100)
  bodyFont        String   @default("Inter") @map("body_font") @db.VarChar(100)
  supportEmail    String?  @map("support_email") @db.VarChar(255)
  instagramUrl    String?  @map("instagram_url") @db.Text
  linkedinUrl     String?  @map("linkedin_url") @db.Text
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

model PublicPage {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(150)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sections PublicPageSection[]
  seo      SeoSetting?

  @@index([active])
  @@map("public_pages")
}

model PublicPageSection {
  id                  String   @id @default(uuid()) @db.Uuid
  pageId              String   @map("page_id") @db.Uuid
  key                 String   @db.VarChar(100)
  eyebrow             String?  @db.VarChar(150)
  title               String?  @db.Text
  subtitle            String?  @db.Text
  content             String?  @db.Text
  buttonText          String?  @map("button_text") @db.VarChar(150)
  buttonUrl           String?  @map("button_url") @db.Text
  secondaryButtonText String?  @map("secondary_button_text") @db.VarChar(150)
  secondaryButtonUrl  String?  @map("secondary_button_url") @db.Text
  imageUrl            String?  @map("image_url") @db.Text
  metadata            Json?
  sortOrder           Int      @default(0) @map("sort_order")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  page PublicPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, key], map: "uk_public_page_sections_page_key")
  @@index([pageId])
  @@index([pageId, active])
  @@index([pageId, sortOrder])
  @@map("public_page_sections")
}

model SeoSetting {
  id            String   @id @default(uuid()) @db.Uuid
  pageId        String   @unique @map("page_id") @db.Uuid
  title         String   @db.VarChar(255)
  description   String   @db.Text
  keywords      String?  @db.Text
  ogTitle       String?  @map("og_title") @db.VarChar(255)
  ogDescription String?  @map("og_description") @db.Text
  ogImageUrl    String?  @map("og_image_url") @db.Text
  canonicalUrl  String?  @map("canonical_url") @db.Text
  robotsIndex   Boolean  @default(true) @map("robots_index")
  robotsFollow  Boolean  @default(true) @map("robots_follow")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  page PublicPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("seo_settings")
}

model Professor {
  id     String  @id @default(uuid()) @db.Uuid
  gymId  String  @db.Uuid
  userId String? @db.Uuid

  name      String
  email     String?
  phone     String?
  birthDate DateTime?

  bio   String?
  notes String?

  hireDate DateTime?
  active   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym  Gym   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  modalities  ProfessorModality[]
  classGroups ClassGroupProfessor[]

  @@index([gymId])
  @@index([gymId, active])
  @@index([gymId, name])
  @@index([userId])
}

model Modality {
  id          String   @id @default(uuid()) @db.Uuid
  gymId       String   @map("gym_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  color       String?  @db.VarChar(7)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  gym         Gym                 @relation(fields: [gymId], references: [id], onDelete: Restrict)
  graduations Graduation[]
  professors  ProfessorModality[]
  classGroups ClassGroup[]

  @@unique([gymId, name], map: "uk_modalities_gym_name")
  @@index([gymId])
  @@index([gymId, active])
  @@index([gymId, name])
  @@map("modalities")
}

model Graduation {
  id          String   @id @default(uuid()) @db.Uuid
  gymId       String   @map("gym_id") @db.Uuid
  modalityId  String   @map("modality_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  color       String?  @db.VarChar(7)
  textColor   String?  @map("text_color") @db.VarChar(7)
  order       Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  gym      Gym      @relation(fields: [gymId], references: [id], onDelete: Restrict)
  modality Modality @relation(fields: [modalityId], references: [id], onDelete: Restrict)

  @@unique([gymId, modalityId, name], map: "uk_graduations_gym_modality_name")
  @@unique([gymId, modalityId, order], map: "uk_graduations_gym_modality_order")
  @@index([gymId])
  @@index([modalityId])
  @@index([gymId, modalityId])
  @@index([gymId, modalityId, active])
  @@index([gymId, modalityId, order])
  @@map("graduations")
}

model ProfessorModality {
  id          String   @id @default(uuid()) @db.Uuid
  gymId       String   @map("gym_id") @db.Uuid
  professorId String   @map("professor_id") @db.Uuid
  modalityId  String   @map("modality_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Restrict)
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  modality  Modality  @relation(fields: [modalityId], references: [id], onDelete: Cascade)

  @@unique([professorId, modalityId], map: "uk_professor_modalities_professor_modality")
  @@index([gymId])
  @@index([professorId])
  @@index([modalityId])
  @@index([gymId, professorId])
  @@index([gymId, modalityId])
  @@map("professor_modalities")
}

model ClassGroup {
  id              String          @id @default(uuid()) @db.Uuid
  gymId           String          @map("gym_id") @db.Uuid
  modalityId      String          @map("modality_id") @db.Uuid
  name            String          @db.VarChar(150)
  description     String?         @db.Text
  level           ClassGroupLevel @default(MIXED)
  minimumAge      Int?            @map("minimum_age")
  maximumAge      Int?            @map("maximum_age")
  maxStudents     Int?            @map("max_students")
  durationMinutes Int             @default(60) @map("duration_minutes")
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  gym        Gym                   @relation(fields: [gymId], references: [id], onDelete: Restrict)
  modality   Modality              @relation(fields: [modalityId], references: [id], onDelete: Restrict)
  professors ClassGroupProfessor[]
  schedules  ClassSchedule[]

  @@unique([gymId, name], map: "uk_class_groups_gym_name")
  @@index([gymId])
  @@index([modalityId])
  @@index([gymId, active])
  @@index([gymId, modalityId])
  @@index([gymId, modalityId, active])
  @@index([gymId, level])
  @@index([gymId, name])
  @@map("class_groups")
}

model ClassGroupProfessor {
  id           String                  @id @default(uuid()) @db.Uuid
  gymId        String                  @map("gym_id") @db.Uuid
  classGroupId String                  @map("class_group_id") @db.Uuid
  professorId  String                  @map("professor_id") @db.Uuid
  role         ClassGroupProfessorRole
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  gym        Gym        @relation(fields: [gymId], references: [id], onDelete: Restrict)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  professor  Professor  @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([classGroupId, professorId], map: "uk_class_group_professors_group_professor")
  @@index([gymId])
  @@index([classGroupId])
  @@index([professorId])
  @@index([gymId, classGroupId])
  @@index([gymId, professorId])
  @@index([classGroupId, role])
  @@map("class_group_professors")
}

model ClassSchedule {
  id           String    @id @default(uuid()) @db.Uuid
  gymId        String    @map("gym_id") @db.Uuid
  classGroupId String    @map("class_group_id") @db.Uuid
  weekday      Weekday
  startTime    DateTime  @map("start_time") @db.Time(0)
  endTime      DateTime  @map("end_time") @db.Time(0)
  room         String?   @db.VarChar(150)
  notes        String?   @db.Text
  validFrom    DateTime? @map("valid_from") @db.Date
  validUntil   DateTime? @map("valid_until") @db.Date
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  gym        Gym        @relation(fields: [gymId], references: [id], onDelete: Restrict)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@index([classGroupId])
  @@index([gymId, active])
  @@index([gymId, weekday])
  @@index([gymId, weekday, active])
  @@index([gymId, classGroupId])
  @@index([gymId, classGroupId, active])
  @@index([gymId, room])
  @@index([validFrom])
  @@index([validUntil])
  @@map("class_schedules")
}
