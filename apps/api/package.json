{
  "name": "@fightops/api",
  "version": "0.1.0",
  "private": true,
  "description": "FightOps REST API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "generate": "pnpm -w exec prisma generate",
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run generate && vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}